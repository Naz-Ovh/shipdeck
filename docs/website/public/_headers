# Response headers for Cloudflare static assets (copied to out/ by next build).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# hashed build files never change
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# the search index has no file extension
/api/search
  Content-Type: application/json; charset=utf-8

# Markdown for language models; the captures use box drawing, so say UTF-8
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/llms.mdx/*
  Content-Type: text/markdown; charset=utf-8

/og/*
  Cache-Control: public, max-age=86400

# the install script, readable in a browser; curl | sh ignores the type
/install.sh
  Content-Type: text/plain; charset=utf-8
