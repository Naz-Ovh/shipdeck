{
  "$id": "https://raw.githubusercontent.com/Naz-Ovh/shipdeck/v0.10.0/docs/schema/deploy.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "App": {
      "additionalProperties": false,
      "description": "One app: a process to run, or a static site to serve.",
      "properties": {
        "binary": {
          "anyOf": [
            {
              "$ref": "#/definitions/FileEntry"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A compiled program: a path, or a path and its place in the app folder. It lands with mode 0755 and is the default `process.start`."
        },
        "exclude": {
          "default": [],
          "description": "Patterns left out of `files`, matched against the path from the project folder.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "files": {
          "default": [],
          "description": "Files shipped for this app.",
          "items": {
            "$ref": "#/definitions/FileEntry"
          },
          "type": "array"
        },
        "nginx": {
          "anyOf": [
            {
              "$ref": "#/definitions/Nginx"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "nginx settings for this app. Without them shipdeck does not touch nginx."
        },
        "process": {
          "anyOf": [
            {
              "$ref": "#/definitions/Process"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A running program. Use this or `static: true`, not both."
        },
        "shared": {
          "default": [],
          "description": "Folders kept across releases, in this app's folder.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source": {
          "default": null,
          "description": "The app's source folder on your PC. Its files keep their path inside it, and its local commands run there. Default: the project folder.",
          "type": [
            "string",
            "null"
          ]
        },
        "static": {
          "default": null,
          "description": "Serve the files instead of running a process. Must be `true`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "steps": {
          "allOf": [
            {
              "$ref": "#/definitions/AppSteps"
            }
          ],
          "default": {
            "backup": {
              "exclude": [],
              "include": [],
              "local": [],
              "server": []
            },
            "build": {
              "local": [],
              "server": []
            },
            "done": {
              "local": [],
              "server": []
            },
            "failed": {
              "local": [],
              "server": []
            },
            "health": {
              "local": [],
              "server": [],
              "url": null
            },
            "nginx": {
              "local": [],
              "server": []
            },
            "preflight": {
              "local": [],
              "server": []
            },
            "restart": {
              "local": [],
              "server": []
            },
            "rollback": {
              "local": [],
              "server": []
            },
            "setup": {
              "local": [],
              "server": []
            },
            "switch": {
              "local": [],
              "server": []
            },
            "upload": {
              "local": [],
              "server": []
            }
          },
          "description": "This app's commands and settings of every step."
        }
      },
      "type": "object"
    },
    "AppBackupStep": {
      "additionalProperties": false,
      "description": "An app's backup step: no `keep`, which belongs to the release.",
      "properties": {
        "exclude": {
          "default": [],
          "description": "Uploaded paths to leave out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "default": [],
          "description": "Paths setup made that it cannot make again.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "local": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On your PC."
        },
        "server": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On the server."
        }
      },
      "type": "object"
    },
    "AppHealthStep": {
      "additionalProperties": false,
      "description": "An app's health step: `url` belongs to the app, `timeout_secs` to the release.",
      "properties": {
        "local": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On your PC."
        },
        "server": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On the server."
        },
        "url": {
          "default": null,
          "description": "The URL fetched on the server. It must answer 2xx.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AppSteps": {
      "additionalProperties": false,
      "description": "The app steps: the same commands, without the release's settings.",
      "properties": {
        "backup": {
          "allOf": [
            {
              "$ref": "#/definitions/AppBackupStep"
            }
          ],
          "default": {
            "exclude": [],
            "include": [],
            "local": [],
            "server": []
          },
          "description": "Step 5. `include` is not allowed for a static app."
        },
        "build": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 2."
        },
        "done": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 10."
        },
        "failed": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 12."
        },
        "health": {
          "allOf": [
            {
              "$ref": "#/definitions/AppHealthStep"
            }
          ],
          "default": {
            "local": [],
            "server": [],
            "url": null
          },
          "description": "Step 9."
        },
        "nginx": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 8."
        },
        "preflight": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 1."
        },
        "restart": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 7."
        },
        "rollback": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 11."
        },
        "setup": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 4. Not allowed for a static app."
        },
        "switch": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 6."
        },
        "upload": {
          "allOf": [
            {
              "$ref": "#/definitions/Step"
            }
          ],
          "default": {
            "local": [],
            "server": []
          },
          "description": "Step 3."
        }
      },
      "type": "object"
    },
    "BackupStep": {
      "additionalProperties": false,
      "description": "Step 5: what stays on the server once a release's folder goes.",
      "properties": {
        "exclude": {
          "default": [],
          "description": "Uploaded paths to leave out.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "include": {
          "default": [],
          "description": "Paths setup made that it cannot make again.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "keep": {
          "anyOf": [
            {
              "$ref": "#/definitions/Keep"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How many old releases stay."
        },
        "local": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On your PC."
        },
        "server": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On the server."
        }
      },
      "type": "object"
    },
    "BuildStep": {
      "additionalProperties": false,
      "description": "Step 2: the build, and the file collection.",
      "properties": {
        "local": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On your PC."
        },
        "server": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On the server."
        },
        "version_from": {
          "default": null,
          "description": "The file whose version names the release.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CommandList": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ],
          "description": "A command: a line run with `sh`, or one runner and the code it runs.",
          "title": "Command"
        },
        {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ],
            "description": "A command: a line run with `sh`, or one runner and the code it runs.",
            "title": "Command"
          },
          "type": "array"
        }
      ],
      "description": "One command, or a list of them run in order, stopping at the first failure."
    },
    "DeployEntry": {
      "anyOf": [
        {
          "description": "A deploy file's path on your PC.",
          "type": "string"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/DeployFile"
            }
          ],
          "description": "The deploy written in the root file."
        }
      ],
      "description": "One entry of a root file: a deploy file's path, or the deploy in place."
    },
    "DeployFile": {
      "additionalProperties": false,
      "description": "One whole deploy: the server, the release and every app.",
      "properties": {
        "apps": {
          "additionalProperties": {
            "$ref": "#/definitions/App"
          },
          "description": "The apps of the deploy, by name. They run in name order.",
          "type": "object"
        },
        "name": {
          "description": "The deploy's name; the default process name starts with it.",
          "type": "string"
        },
        "release": {
          "allOf": [
            {
              "$ref": "#/definitions/Release"
            }
          ],
          "default": {
            "exclude": [],
            "files": [],
            "shared": [],
            "steps": {
              "backup": {
                "exclude": [],
                "include": [],
                "keep": null,
                "local": [],
                "server": []
              },
              "build": {
                "local": [],
                "server": [],
                "version_from": null
              },
              "done": {
                "local": [],
                "server": []
              },
              "failed": {
                "local": [],
                "server": []
              },
              "health": {
                "local": [],
                "server": [],
                "timeout_secs": 20,
                "url": null
              },
              "nginx": {
                "local": [],
                "server": []
              },
              "preflight": {
                "local": [],
                "requires": [],
                "server": []
              },
              "restart": {
                "local": [],
                "server": []
              },
              "rollback": {
                "ask_secs": null,
                "keep_failed": null,
                "local": [],
                "mode": null,
                "server": []
              },
              "setup": {
                "local": [],
                "server": []
              },
              "switch": {
                "local": [],
                "server": []
              },
              "upload": {
                "local": [],
                "server": []
              }
            }
          },
          "description": "Settings for the whole release; each app adds its own."
        },
        "server": {
          "allOf": [
            {
              "$ref": "#/definitions/Server"
            }
          ],
          "description": "The server it runs on."
        }
      },
      "required": [
        "name",
        "server",
        "apps"
      ],
      "type": "object"
    },
    "FileEntry": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A path and, when it needs one, its place in the release.",
          "properties": {
            "path": {
              "description": "The path on your PC.",
              "type": "string"
            },
            "to": {
              "default": null,
              "description": "Where it lands, relative to the release or app folder. Optional for a binary, whose file name is its place.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      ],
      "description": "A path on your PC, or a map with `path` and `to`."
    },
    "HealthStep": {
      "additionalProperties": false,
      "description": "Step 9: the release must answer.",
      "properties": {
        "local": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On your PC."
        },
        "server": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On the server."
        },
        "timeout_secs": {
          "default": 20,
          "description": "Seconds the release has to become healthy. Default: 20.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "url": {
          "default": null,
          "description": "The URL fetched on the server. It must answer 2xx.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Keep": {
      "additionalProperties": false,
      "description": "Old releases kept on the server, for rollback.",
      "properties": {
        "compressed": {
          "default": 15,
          "description": "Older releases kept only as their backup. 0 keeps none. Default: 15.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "open": {
          "default": 5,
          "description": "Releases kept unpacked and ready to switch to, counting the live one. Default: 5.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Nginx": {
      "additionalProperties": false,
      "description": "nginx settings for one app. Parsed and checked; not built yet.",
      "properties": {
        "domains": {
          "default": [],
          "description": "The domains this app answers on.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Response headers to add.",
          "type": "object"
        },
        "index": {
          "default": null,
          "description": "The file nginx serves for a folder, for a static app.",
          "type": [
            "string",
            "null"
          ]
        },
        "locations": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "default": {},
          "description": "Extra `location` blocks, by path.",
          "type": "object"
        },
        "proxy_pass": {
          "default": null,
          "description": "Where the app listens, for a process app.",
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {
          "default": null,
          "description": "Raw nginx directives, added to the server block as they are.",
          "type": [
            "string",
            "null"
          ]
        },
        "root": {
          "default": null,
          "description": "The folder nginx serves, in the app folder, for a static app.",
          "type": [
            "string",
            "null"
          ]
        },
        "tls": {
          "anyOf": [
            {
              "$ref": "#/definitions/Tls"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A certificate for those domains, or `none` for plain HTTP."
        }
      },
      "type": "object"
    },
    "Oxmgr": {
      "additionalProperties": false,
      "description": "An oxmgr app. Parsed and checked; not built yet.",
      "properties": {
        "options": {
          "additionalProperties": true,
          "default": {},
          "description": "oxfile app properties.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "Pm2": {
      "additionalProperties": false,
      "description": "A PM2 app: the file shipdeck writes, or your own ecosystem file.",
      "properties": {
        "ecosystem": {
          "default": null,
          "description": "Your own PM2 file, in the app folder. It replaces `options`.",
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "additionalProperties": true,
          "default": {},
          "description": "PM2 app properties, such as `instances` or `max_memory_restart`.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "PreflightStep": {
      "additionalProperties": false,
      "description": "Step 1: checks before anything else.",
      "properties": {
        "local": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On your PC."
        },
        "requires": {
          "default": [],
          "description": "Programs the server must have.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "server": {
          "allOf": [
            {
              "$ref": "#/definitions/CommandList"
            }
          ],
          "default": [],
          "description": "On the server."
        }
      },
      "type": "object"
    },
    "Process": {
      "additionalProperties": false,
      "description": "A running program and the manager that keeps it up.",
      "properties": {
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Environment variables for the app and its server commands.",
          "type": "object"
        },
        "env_file": {
          "default": null,
          "description": "A `KEY=value` file in the app folder, such as `.env`.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "default": null,
          "description": "The process name. Default: `<name>-<app>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "oxmgr": {
          "anyOf": [
            {
              "$ref": "#/definitions/Oxmgr"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "An oxmgr app. Use exactly one of `systemd`, `pm2` or `oxmgr`."
        },
        "pm2": {
          "anyOf": [
            {
              "$ref": "#/definitions/Pm2"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A PM2 app. Use exactly one of `systemd`, `pm2` or `oxmgr`."
        },
        "start": {
          "default": null,
          "description": "The command that runs the app, in the app folder. Default: `./<binary>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "systemd": {
          "anyOf": [
            {
              "$ref": "#/definitions/Systemd"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A systemd unit. Use exactly one of `systemd`, `pm2` or `oxmgr`."
        }
      },
      "type": "object"
    },
    "Release": {
      "additionalProperties": false,
      "description": "The whole release: files that belong to no app, and the release commands.",
      "properties": {
        "exclude": {
          "default": [],
          "description": "Patterns left out of `files`, matched against the path from the project folder.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "files": {
          "default": [],
          "description": "Files shipped beside the apps, each at its path from the project folder.",
          "items": {
            "$ref": "#/definitions/FileEntry"
          },
          "type": "array"
        },
        "shared": {
          "default": [],
          "description": "Folders kept across releases, each at its path in the release.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "steps": {
          "allOf": [
            {
              "$ref": "#/definitions/ReleaseSteps"
            }
          ],
          "default": {
            "backup": {
              "exclude": [],
              "include": [],
              "keep": null,
              "local": [],
              "server": []
            },
            "build": {
              "local": [],
              "server": [],
              "version_from": null
            },
            "done": {
              "local": [],
              "server": []
            },
            "failed": {
              "local": [],
              "server": []
            },
            "health": {
              "local": [],
              "server": [],
              "timeout_secs": 20,
              "url": null
            },
            "nginx": {
              "local": [],
              "server": []
            },
            "preflight": {
              "local": [],
              "requires": [],
              "server": []
            },
            "restart": {
              "local": [],
              "server": []
            },
            "rollback": {
              "ask_secs": null,
              "keep_failed": null,
              "local": [],
              "mode": null,
              "server": []
            },
            "setup": {
              "local": [],
              "server": []
            },
            "switch": {
              "local": [],
              "server": []
            },
            "upload": {
              "local": [],
              "server": []
            }
          },
          "description": "The release commands and settings of every step."
        }
      },
      "type": "object"
    },
    "ReleaseSteps": {
      "additionalProperties": false,
      "description": "The release steps, with the settings each takes.",
      "properties": {
        "backup": {
          "allOf": [
            {
              "$ref": "#/definitions/BackupStep"
            }
          ],
          "default": {
            "exclude": [],
            "include": [],
            "keep": null,
            "local": [],
            "server": []
          },
          "description": "Step 5."
        },
        "build": {
          "allOf": [
            {
              "$ref": "#/definitions/BuildStep"
            }
          ],
          "default": {
            "local": [],
            "server": [],
            "version_from": null
          },
          "description": "Step 2."
        },
        "done": {
          "allOf": [
            {
